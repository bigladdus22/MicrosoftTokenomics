{
  "name": "@ai-credits/engine",
  "version": "0.1.0",
  "description": "Pure TypeScript forecast engine: estimate inputs + versioned rate card -> credits, cost, purchase mix. No React, no backend.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rate-card/*": "./src/rate-card/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
